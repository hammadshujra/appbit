NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
R2_CREDENTIALS_KEY=replace-with-a-separate-long-random-secret-at-least-32-characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Hostinger MySQL is normally localhost for a database created in the same hPanel website.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password
DB_SSL=false

TRUST_PROXY=1
WORK_LOCK_TIMEOUT_SECONDS=90
APK_RESOLVER_DAILY_PAGES=8
APK_RESOLVER_FULL_PAGES=80
APK_RESOLVER_MAX_ITEMS=50000
APK_RESOLVER_REQUEST_GAP_MS=1400
