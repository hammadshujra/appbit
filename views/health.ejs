<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>System health · Appbit</title><link rel="icon" href="/favicon.svg?v=251" type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/app.css?v=<%= appVersion %>"></head><body class="standalone"><main class="health-page"><section class="health-hero"><div class="health-hero-brand"><img src="/studio-logo.svg?v=251" alt="Appbit"><div><b>APPBIT</b><span>Deployment health</span></div></div><div><span class="auth-eyebrow">SYSTEM STATUS</span><h1><%= state.dbReady ? 'Your studio is ready.' : 'Checking your deployment.' %></h1><p>Safe deployment diagnostics for Hostinger. Credentials are never displayed here.</p></div><div class="health-state <%= state.dbReady ? 'healthy' : 'waiting' %>"><span></span><b><%= state.dbReady ? 'Core checks passing' : 'Action required' %></b></div></section><section class="health-main"><div class="health-heading"><div><h2>System health</h2><p>Runtime, database, schema, and download gateway.</p></div><span class="health-version">V<%= appVersion %></span></div><div class="health-checks"><% checks.forEach(c => { %><div class="health-check"><span class="health-check-icon <%= c[1] ? 'pass' : 'fail' %>"><%= c[1] ? '✓' : '!' %></span><div><b><%= c[0] %></b><span><%= c[2] %></span></div></div><% }) %></div><div class="health-actions"><a class="btn btn-primary" href="<%= state.dbReady ? '/' : '/health' %>"><%= state.dbReady ? 'Open Appbit' : 'Retry Health' %></a><a class="btn" href="/login">Open sign in</a></div></section></main></body></html>
