<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>System health · Appbit</title><link rel="icon" href="/favicon.svg?v=252" type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/app.css?v=252"></head><body class="standalone"><main class="health-split-page"><section class="health-visual-panel"><div class="auth-brand"><img src="/studio-logo.svg?v=252" alt="Appbit"><div><b>APPBIT</b><span>Studio Manager</span></div></div><div class="health-visual-copy"><span class="auth-eyebrow">DEPLOYMENT STATUS</span><h1><%= state.dbReady ? 'Everything is ready.' : 'Checking your studio.' %></h1><p>Private deployment diagnostics for Appbit on Hostinger. Runtime, database, schema, and download gateway are checked without displaying credentials.</p><div class="health-live-badge <%= state.dbReady ? 'ok' : '' %>"><i></i><span><%= state.dbReady ? 'All core systems operational' : 'Action required' %></span></div></div><div class="health-visual-stats"><div><b><%= checks.length %></b><span>Total checks</span></div><div><b><%= checks.filter(c=>c[1]).length %></b><span>Passing</span></div><div><b>V<%= appVersion %></b><span>Studio version</span></div></div><div class="health-visual-art" aria-hidden="true"><span></span><span></span><span></span></div></section><section class="health-panel-wrap"><div class="health-panel-card"><div class="health-panel-head"><div><span class="auth-eyebrow">SYSTEM HEALTH</span><h2>Deployment checks</h2><p>Safe checks for the current deployment.</p></div><span class="health-status-chip <%= state.dbReady ? 'ok' : '' %>"><%= state.dbReady ? 'Ready' : 'Check' %></span></div><div class="health-check-list"><% checks.forEach(c=>{ %><div class="health-check-line"><span class="health-check-icon <%= c[1] ? 'pass' : 'fail' %>"><%= c[1] ? '✓' : '!' %></span><div><b><%= c[0] %></b><span><%= c[2] %></span></div></div><% }) %></div><div class="health-actions"><a class="btn btn-primary" href="<%= state.dbReady ? '/' : '/health' %>"><%= state.dbReady ? 'Open Appbit' : 'Check again' %></a><a class="btn health-secondary" href="/login">Open sign in</a></div><div class="health-foot"><span>Appbit deployment health</span><span>Hostinger runtime</span></div></div></section></main></body></html>
